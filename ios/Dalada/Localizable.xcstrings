{
  "sourceLanguage": "ru",
  "strings": {
    "auth.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте ещё раз. Если не получается — проверьте интернет."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Қайта көріңіз. Болмаса, интернетті тексеріңіз."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again. If it keeps failing, check your connection."
          }
        }
      }
    },
    "auth.error.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кіру мүмкін болмады"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t sign in"
          }
        }
      }
    },
    "auth.google": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти через Google"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google арқылы кіру"
          }
