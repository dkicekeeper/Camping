    "offlineMaps.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download an area in advance, preferably over Wi‑Fi, and the map there opens without signal. Places, reports and rules are saved separately: open them at least once while online."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ауданды алдын ала, жақсысы Wi‑Fi арқылы жүктеңіз — онда карта байланыссыз ашылады. Орындар, есептер мен ережелер бөлек сақталады: оларды желімен кемінде бір рет ашыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачайте район заранее, лучше по Wi‑Fi, — карта там откроется без связи. Места, отчёты и правила сохраняются отдельно: откройте их хотя бы раз с сетью."
          }
        }
      }
    },
