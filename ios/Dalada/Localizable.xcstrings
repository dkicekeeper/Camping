    "privacyZones.radiusHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Others don't see the track inside the circle. The hidden area is a bit larger and randomly shifted so the center can't be found from cut tracks."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Шеңбер ішіндегі тректі басқалар көрмейді. Жасырын аймақ сәл үлкенірек және кездейсоқ ығыстырылған — кесілген тректер бойынша ортасын табу мүмкін болмауы үшін."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутри круга трек не виден другим. Скрытая область чуть больше круга и сдвинута случайно, чтобы по обрезанным трекам нельзя было найти центр."
          }
        }
      }
    },
