    "account.delete.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile, places, check-ins and catches with photos, trips, reviews, discussions, friends, gear and checklists will be deleted from the server and this phone. This can't be undone."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Профиль, орындар, белгілер мен фотолы олжалар, сапарлар, пікірлер, талқылаулар, достар, жабдық пен чеклистер серверден және осы телефоннан жойылады. Қалпына келтіру мүмкін емес."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалятся профиль, места, чекины и уловы с фото, поездки, отзывы, обсуждения, друзья, экипировка и чеклисты — на сервере и на этом телефоне. Восстановить нельзя."
          }
        }
      }
    },
    "account.delete.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your data will be deleted. It can't be restored."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Барлық деректеріңіз жойылады. Оларды қалпына келтіру мүмкін болмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все ваши данные будут удалены. Восстановить их будет нельзя."
          }
        }
      }
    },
