        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Google"
          }
        }
      }
    },
    "auth.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без входа можно смотреть карту и публичные места."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кірмей-ақ картаны және ашық орындарды көруге болады."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without signing in you can browse the map and public places."
          }
        }
      }
    },
    "auth.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы сохранять места и поездки"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Орындар мен сапарларды сақтау үшін кіріңіз"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to save places and trips"
          }
        }
      }
    },
