    "fish.minSize.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per the Fishing Rules of Kazakhstan for the Balkhash-Alakol basin. Length is measured from the tip of the snout to the base of the middle tail rays."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ҚР Балық аулау қағидалары бойынша Балқаш-Алакөл бассейні үшін. Ұзындығы — тұмсық ұшынан құйрық қанатының ортаңғы сәулелерінің негізіне дейін."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По Правилам рыболовства РК для Балхаш-Алакольского бассейна. Длина — от вершины рыла до основания средних лучей хвостового плавника."
          }
        }
      }
    },
