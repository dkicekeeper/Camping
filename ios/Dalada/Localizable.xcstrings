    "trip.finish.visibilityFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For now, only you can see your trips. Sharing with friends comes later, and the start and end of the track near home will be hidden."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Әзірге сапарларды тек сіз көресіз. Достармен бөлісу кейінірек болады — сонда тректің үй маңындағы басы мен соңы жасырылады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока поездки видите только вы. Делиться ими с друзьями можно будет позже — тогда начало и конец трека у дома будут скрыты."
          }
        }
      }
    },
