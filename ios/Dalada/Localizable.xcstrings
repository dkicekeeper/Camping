    "onboarding.username.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По нему вас найдут друзья. Латиница, цифры, «_» и «.», от 3 до 30 символов."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Достарыңыз сізді осы арқылы табады. Латын әріптері, сандар, «_» және «.», 3–30 таңба."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends will find you by it. Latin letters, digits, “_” and “.”, 3 to 30 characters."
          }
        }
      }
    },
