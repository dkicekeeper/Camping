    "consent.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalada stores your profile, places, check-ins, catches, photos and trips on a Supabase server in Germany, outside Kazakhstan. You choose who sees what: everyone, friends or only you. Reviews and discussions of public places are visible to everyone; we remove anything that breaks the community rules."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dalada профиліңізді, орындарыңызды, белгілеріңізді, олжаңызды, фотоларыңызды және сапарларыңызды Германиядағы Supabase серверінде — Қазақстаннан тыс жерде сақтайды. Кім нені көретінін өзіңіз таңдайсыз: «барлығы», «достар» немесе «тек мен». Жария орындардың пікірлері мен талқылауларын барлығы көреді; қауымдастық ережелерін бұзатынын жоямыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalada хранит ваш профиль, места, чекины, уловы, фото и поездки на сервере Supabase в Германии — за пределами Казахстана. Кто что видит, вы выбираете сами: «все», «друзья» или «только я». Отзывы и обсуждения публичных мест видят все; то, что нарушает правила сообщества, мы удаляем."
          }
        }
      }
    },
    "consent.checkbox" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I accept the terms of use, community rules and privacy policy and agree that my data is stored outside Kazakhstan"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мен пайдалану шарттарын, қауымдастық ережелерін және құпиялылық саясатын қабылдаймын және деректерімнің Қазақстаннан тыс жерде сақталуына келісемін"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я принимаю условия использования, правила сообщества и политику конфиденциальности и соглашаюсь на хранение моих данных за пределами Казахстана"
          }
        }
      }
    },
    "consent.continue" : {
