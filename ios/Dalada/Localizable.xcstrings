    "intro.offline.download" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download the area"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ауданды жүктеу"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачать район"
          }
        }
      }
    },
    "intro.offline.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s often no signal in the mountains or by the water. Download the area in advance — Wi‑Fi is best. More areas are in Tips → Getting ready."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тауда және су айдындарында байланыс жиі болмайды. Ауданды алдын ала жүктеп алыңыз — Wi‑Fi арқылы жақсырақ. Басқа аудандар — «Лайфхактар» → «Дайындық» бөлімінде."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В горах и на водоёмах связи часто нет. Скачайте район заранее — лучше по Wi‑Fi. Другие районы — в «Лайфхаки» → «Подготовка»."
          }
        }
      }
    },
    "intro.offline.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline map"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Желісіз карта"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта без сети"
          }
        }
      }
    },
    "intro.places.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lakes, campsites and springs from our editors, plus fresh reports from anglers: bite, water, road, photos."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Редакциядан су айдындары, тұрақтар мен бұлақтар және балықшылардың жаңа есептері: қабуы, су, жол, фото."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Водоёмы, стоянки и родники от редакции и свежие отчёты рыбаков: клёв, вода, дорога, фото."
          }
        }
      }
    },
    "intro.places.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Places where fish bite"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Балық қабатын жерлер"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места, где клюёт"
          }
        }
      }
    },
    "intro.rules.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spawning bans and size limits on the map and on each place card — even offline."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уылдырық шашу кезеңіндегі тыйымдар мен кәсіптік өлшем — картада және орын карточкасында, желісіз де."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нерестовые запреты и промысловая мера — на карте и в карточке места, даже без сети."
          }
        }
      }
    },
    "intro.rules.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bans and rules"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тыйымдар мен ережелер"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запреты и правила"
          }
        }
      }
    },
    "intro.signIn.guest" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue without signing in"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кірмей жалғастыру"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжить без входа"
          }
        }
      }
    },
    "intro.signIn.guest.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without an account you can browse places, rules and articles. You can sign in later in Profile."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кірмей-ақ орындарды, ережелер мен мақалаларды көруге болады. Кейін «Профиль» бөлімінде кіруге болады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без входа можно смотреть места, правила и статьи. Войти можно позже в «Профиле»."
          }
        }
      }
    },
    "intro.skip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Өткізіп жіберу"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустить"
          }
        }
      }
    },
    "intro.trips.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record your track and catches. Keep your spots secret or share them with friends only."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Трек пен олжаларды жазыңыз. Өз орындарыңызды құпия қалдыруға немесе тек достарға көрсетуге болады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте трек и уловы. Свои места можно оставить секретными или показать только друзьям."
          }
        }
      }
    },
    "intro.trips.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trips and catches"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сапарлар мен олжалар"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поездки и уловы"
          }
        }
      }
    },
    "intro.welcome.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fishing and outdoors in the Almaty region and Zhetysu: where to fish, what’s allowed and how to get there."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Алматы облысы мен Жетісудағы балық аулау және табиғаттағы демалыс: қайда аулау керек, не рұқсат және қалай жетуге болады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рыбалка и отдых на природе в Алматинской области и Жетісу: где ловить, что можно и как добраться."
          }
        }
      }
    },
    "intro.welcome.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Dalada"
          }
        },
