    "intro.location.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location lets us show places nearby, confirm check-ins and record tracks. No one sees where you are right now."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Геолокация жақын орындарды көрсету, белгіні растау және трек жазу үшін қажет. Қазір қайда екеніңізді ешкім көрмейді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция нужна, чтобы показать места рядом, подтвердить чекин и записать трек. Где вы сейчас, никто не видит."
          }
        }
      }
    },
    "intro.location.title" : {
