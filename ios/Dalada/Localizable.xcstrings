    "onboarding.username.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только латиница в нижнем регистре, цифры, «_» и «.»; точка не в начале и не в конце"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тек кіші латын әріптері, сандар, «_» және «.»; нүкте басында немесе соңында болмайды"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowercase Latin letters, digits, “_” and “.” only; no dot at the start or end"
          }
        }
      }
    },
