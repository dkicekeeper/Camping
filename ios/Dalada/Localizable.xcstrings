    "privacyZones.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Others don't see the parts of your tracks inside these zones — around your home or dacha, for example. The start and end of a track are always hidden, even without zones."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Басқалар тректеріңіздің осы аймақтардағы бөліктерін көрмейді — мысалы, үй немесе саяжай маңында. Тректің басы мен соңы аймақтарсыз да әрқашан жасырылады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие не видят участки ваших треков внутри зон — например, у дома или дачи. Начало и конец трека скрыты всегда, даже без зон."
          }
        }
      }
    },
    "privacyZones.limit" : {
