<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Остальные ключи генерирует Xcode (GENERATE_INFOPLIST_FILE) из project.yml. -->
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabaseKey</key>
	<string>$(SUPABASE_KEY)</string>
	<!-- Ссылки dalada://u/<username> (приглашение в друзья) и возврат после входа. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.dalada.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dalada</string>
			</array>
		</dict>
	</array>
	<!-- «Маршрут»: какие навигаторы установлены (2GIS, Яндекс Навигатор и Карты, Google Карты). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>dgis</string>
		<string>yandexnavi</string>
		<string>yandexmaps</string>
		<string>comgooglemaps</string>
	</array>
	<!-- Запись трека поездки в фоне (CLBackgroundActivitySession) и фоновое обновление:
	     отправка офлайн-очереди (BackgroundSync). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.dalada.ios.sync</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Только для локального Supabase (http://127.0.0.1:54321) при разработке. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
