    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы показать вас на карте, отмечаться в местах и записывать поездки."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сізді картада көрсету, орындарда белгілену және сапарларды жазу үшін."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show you on the map, check in at places and record trips."
          }
        }
      }
    }
